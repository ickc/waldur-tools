# direnv configuration -- safe to commit.
#
# Secrets live in .envrc.local, which is gitignored and never committed.
# Create it with:
#
#     echo 'export WALDUR_API_TOKEN=<your token>' > .envrc.local
#
# The token comes from the Isambard portal, under your own account menu.

export WALDUR_API_URL="${WALDUR_API_URL:-https://portal-api.isambard.ac.uk}"

# Snapshots default to ./data (gitignored) so repeated runs do not hammer the API.
export WALDUR_CACHE_DIR="${WALDUR_CACHE_DIR:-$PWD/data}"

source_env_if_exists .envrc.local

if [ -z "${WALDUR_API_TOKEN:-}" ]; then
  echo "direnv: warning: WALDUR_API_TOKEN is unset; see .envrc for how to set it" >&2
fi
