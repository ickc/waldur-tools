# direnv configuration -- safe to commit, and entirely optional.
#
# Everything this project needs is set up by pixi: see scripts/activate.sh,
# which pixi sources on every command and which in turn reads the gitignored
# .envrc.local. This file only hands that same environment to your interactive
# shell, so you can run `waldur-tools ...` without the `pixi run` prefix.

watch_file pixi.lock
# shell-hook evaluates the activation once, so re-run it whenever the token
# file changes -- portal tokens expire within hours and get rewritten often.
watch_file .envrc.local
eval "$(pixi shell-hook)"
